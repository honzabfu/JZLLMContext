# Specific files to ignore

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temp
tmp/
temp/
*.tmp

# IDE
.vscode/
.idea/
*.user
**/xcuserdata/
.claude/settings.local.json

# Secrets
.env
.env.*
!.env.example
!.env.sample
*.key
*.pfx
*.p12
*.pem
*.keychain
*.keychain-db
*.mobileprovision

# Local app configuration and recovery copies
config.json
config.json.corrupt*

# Build
# bin/
# obj/
# dist/
build/
DerivedData/
*.xcresult/

# Node
node_modules/

# Python
__pycache__/
*.pyc

# Misc
# *.bak
*.swp

